class Solution {
    public Queue<Integer> reverseFirstK(Queue<Integer> q, int k) {
        // code here
        Stack<Integer> st = new Stack<>();
        
        if(q.size()<k){
            return q;
        }
        
        for(int i=1;i<=k;i++){
            st.push(q.peek());
            q.poll();
        }
        while(!st.isEmpty()){
            q.offer(st.peek());
            st.pop();
        }
        for(int i=1;i<=q.size()-k;i++){
            q.offer(q.poll());
            
        }
        return q;
        
        
    }
}
