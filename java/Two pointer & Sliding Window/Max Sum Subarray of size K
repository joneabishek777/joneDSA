class Solution {
    public int maxSubarraySum(int[] arr, int k) {
        // Code here
        int i=0;
        int j=0;
        int sum = 0;
        int maxsum = 0;
        int n = arr.length;
        while(j<n){
            if(j-i+1 < k){
                sum = sum + arr[j];
                j++;
            }
            else if(j-i+1==k){
                sum = sum + arr[j];
                
                if(maxsum < sum){
                    maxsum = sum;
                }
                sum = sum - arr[i];
                i++;
                j++;
            }
        }
        return maxsum;
    }
}
