class Solution {
    public static ArrayList<Integer> findUnion(int a[], int b[]) {
        // code here
        
        ArrayList<Integer> res = new ArrayList<>();
        Arrays.sort(a);
        Arrays.sort(b);
        int i=0;
        int j=0;
        while(i<a.length && j<b.length){
            if(a[i]<b[j]){
                if(res.size() == 0 || res.get(res.size()-1)!=a[i]){
                    res.add(a[i]);
                }
                i++;
            }
            else if (b[j]<a[i]){
            if(res.size() == 0 || res.get(res.size()-1)!=b[j]){
                    res.add(b[j]);
                }
                j++;
            }
            else{
                if(res.size() == 0 || res.get(res.size()-1)!=a[i]){
                    res.add(b[j]);
                }
                i++;
                j++;
            }
        }
       
        while(i<a.length){
            if(res.size() == 0 || res.get(res.size()-1)!=a[i]){
                    res.add(a[i]);
                }
                i++;
        }
        while(j<b.length){
            if(res.size() == 0 || res.get(res.size()-1)!=b[j]){
                    res.add(b[j]);
                }
                j++;
        }
        
         return res;
    }
}
