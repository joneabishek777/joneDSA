https://www.geeksforgeeks.org/problems/first-negative-integer-in-every-window-of-size-k3345/1
class Solution {
    static List<Integer> firstNegInt(int arr[], int k) {
        // write code here
        Queue <Integer> q = new LinkedList<>();
        List <Integer> ans = new ArrayList<>();
        int n = arr.length;
     
        int i = 0;
        int j = 0;

        while(j<n){
            if(arr[j]<0){
                q.offer(arr[j]);
            }
            if(j-i+1 < k){
                j++;
            }
            else if (j-i+1 == k){
                if(q.isEmpty()){
                    ans.add(0);
                
                }
                else{
                    ans.add(q.peek());
        
                }
                if(arr[i]<0){
                    q.poll();
                }
                i++;
                j++;
            }
        }
        
        return ans;
        
    }
}
