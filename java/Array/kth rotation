class Solution {
    public int findKRotation(int arr[]) {
        // Code here
       int small = arr[0];
       int k = 0;
        for(int i=1;i<arr.length;i++){
            if(small>arr[i]){
                small=arr[i];
                k=i;
            }
        }
        
        return k;
    }
}
