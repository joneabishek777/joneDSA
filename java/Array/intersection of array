class Solution {
    public int[] intersection(int[] nums1, int[] nums2){
        int [] res = new int [nums1.length+nums2.length];
        int h=0;
       for(int i=0;i<nums1.length;i++){
            for(int j=0;j<nums2.length;j++){
                if(nums1[i]==nums2[j]){
                   int flag = 1;
                   for(int k=0;k<h;k++){
                    if(res[k]==nums1[i]){
                        flag = 0;
                        break;
                    }
                   }
                   if(flag==1){
                    res[h]=nums1[i];
                    h++;
                   }
                }
            }
        }       
        int[] ans = new int[h];
        for (int i = 0; i < h; i++) {
            ans[i] = res[i];
        }

        return ans;
    }
}
