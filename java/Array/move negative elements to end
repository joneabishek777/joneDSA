class Solution {
    public void segregateElements(int[] arr) {
        int j=0;
        int n = arr.length;
        int [] b = new int[n];
        int [] c = new int[n];
        for(int i=0;i<n;i++){
            if(arr[i]>=0){
                b[j]=arr[i];
                j++;
            }
        }
        for(int i=0;i<n;i++){
            if(arr[i]<0){
                b[j]=arr[i];
                j++;
            }
        }
        for(int i=0;i<n;i++){
            arr[i]=b[i];
        }
    }
}
        
    
