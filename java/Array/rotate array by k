class Solution {
    public void rotate(int[] a, int k) {
        int n = a.length;
        int j=0;
        k=k%n;
        int[] b = new int[n]; 
        for(int i=n-k;i<n;i++){
            b[j]=a[i];
            j++;
        }
        for(int i=0;i<n-k;i++){
            b[j]=a[i];
            j++;
        }
        for(int i=0;i<n;i++){
            a[i]=b[i];
        }
        
    }
}
