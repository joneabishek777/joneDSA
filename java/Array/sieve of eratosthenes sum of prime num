import java.util.*;
class Main {
    public static void main(String[] args){
        Scanner scan = new Scanner(System.in);
        int L = scan.nextInt();
        int R = scan.nextInt();
        int [] a = new int[R+1];
        for(int i=2;i*i<=R;i++){
            if(a[i]==0){
                for(int j=i*i;j<=R;j=j+i){
                    a[j]=1;
                }
            }
        }
        
        int sum = 0;
         for (int i = L; i <= R; i++) {
            if (i > 1 && a[i] == 0) {
                sum += i;
            }
        }

       System.out.println(sum);
    }
}    
    
