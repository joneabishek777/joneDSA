class Solution {
    public static boolean areAnagrams(String s1, String s2) {
        // code here
        int [] freq = new int [256];
       if(s1.length()!=s2.length())   return false;
      
      for(int i=0;i<s1.length();i++){
          freq[s1.charAt(i)]++;
      }
       for(int i=0;i<s2.length();i++){
          freq[s2.charAt(i)]--;
      }
      
      for (int i=0;i<256;i++){
          if(freq[i]!=0){
              return false;
          }
      }
      
      return true;
    }
}
