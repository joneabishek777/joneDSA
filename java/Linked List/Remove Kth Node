https://www.geeksforgeeks.org/problems/remove-every-kth-node/1
class Solution {
    /*You are required to complete this method*/
    Node deleteK(Node head, int k) {
        // Your code here
        Node ptr = head;
        Node prev =  null;
        int c =0;
        while(ptr != null){
            c++;
            if(c==k){
                prev.next=ptr.next;
                c=0;
            }
            prev = ptr;
            ptr=prev.next;
            }
             return head;
        }
       
    }
