https://www.geeksforgeeks.org/problems/nth-node-from-end-of-linked-list/1
class Solution {
    int getKthFromLast(Node head, int k) {
        Node fast = head;
        Node slow = head;
        
    for (int i = 0; i < k; i++) {
    if (fast == null) {
        return -1;  
    }
    fast = fast.next;
}
        while(fast!=null){
            fast = fast.next;
            slow = slow.next;
        }
        return slow.data;
        
    }
}
