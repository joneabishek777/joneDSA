class Solution {
    Node deleteNode(Node head, int x) {
        // code here
        if(x==1){
            return head.next;
        }
        
        Node temp = head;
        Node temp1=null;
        int index = 1;

        while (temp!= null) {
            if (index == x) {
               temp1.next=temp.next;
               break;
    }
      temp1 = temp;
      temp=temp.next;
      index++;
    }
   return head;
   }
}
