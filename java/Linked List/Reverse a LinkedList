https://www.geeksforgeeks.org/problems/reverse-a-linked-list/1?page=1
class Solution {
    Node reverseList(Node head) {
        // code here
       Node prev = null;
       Node curr = head;

        while (head != null) {
            curr = head.next;
            head.next = prev;
            prev = head;
            head = curr;
        }
        return prev; 
    }
}
