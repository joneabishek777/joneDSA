class Solution {
    public int minValue(Node root) {
        // code here
        if(root == null){
            return Integer.MAX_VALUE;
        }
        if(root.left==null){
            return root.data;
        }
        return minValue(root.left);
    }
}

another method but it can use in binary tree 


 class Solution {
    public int minValue(Node root) {
        // code here
        if(root == null){
            return Integer.MAX_VALUE;
        }
        return Math.min(Math.min(minValue(root.left),minValue(root.right)),root.data);
    }
}
