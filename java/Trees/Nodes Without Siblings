https://www.geeksforgeeks.org/problems/print-all-nodes-that-dont-have-sibling/1
class Solution {
    ArrayList <Integer> ans = new ArrayList<>();
    public void height(Node root) {
        // code here
        if(root==null)     return ;
        if(root.left!=null && root.right==null)      ans.add(root.left.data);
        if(root.left==null && root.right!=null)      ans.add(root.right.data);
        height(root.left);
        height(root.right);
    }
    
 public List<Integer> noSibling(Node root) {
     height(root);
      if(ans.isEmpty())                    ans.add(-1);
     Collections.sort(ans);
     return ans;
 }
}
