class Solution {
    public int findMin(int[] arr) {
        // code here
        int n = arr.length;
        int l=0;
        int h=n-1;
        while(l<=h){
            int mid = (l+h)/2;
            int i = (mid-1+n)%n;
            int j = (mid+1)%n;
            if(arr[mid]<arr[i] && arr[mid]<arr[j]){
                return arr[mid];
            }
            if(arr[h]>arr[mid]){
                h = mid-1;
            }
            else{
                l = mid+1;
            }
        }
        return arr[0];
        
    }
}
