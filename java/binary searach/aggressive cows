class Solution {
    static boolean check(int[]stalls,int k,int dist){
       int count =1;
       int prev = stalls[0];
       for(int i=1;i<stalls.length;i++){
           if(stalls[i]-prev>=dist){
               prev = stalls[i];
               count++;
           }
           if(count>=k){
               return true;
           }
       }
       return false;
    }
    
    public int aggressiveCows(int[] stalls, int k) {
        Arrays.sort(stalls);
        int low = 1;
        int high = stalls[stalls.length-1]-stalls[0];
        int ans = 0;
        while(low<=high){
            int mid = (low+high)/2;
            if(check(stalls,k,mid)){
                ans = mid;
                low = mid+1;
            }
            else{
                high = mid-1;
            }
        }
         return high;
        }
}
