https://leetcode.com/problems/capacity-to-ship-packages-within-d-days/
class Solution {
   public int caldays(int[] weights,int capacity){
    int days =1,n=weights.length,sum=0;
    for(int i=0;i<n;i++){
        if(sum+weights[i]<=capacity){
            sum = sum+weights[i];
        }
        else{
            sum = weights[i];
            days++;
        }
    }
    return days;
   }
    public int shipWithinDays(int[] weights, int days) {
        int low =0;
        int high =0;
        for(int i=0;i<weights.length;i++){
            high = high+weights[i];
            low = Math.max(low,weights[i]);
        }
        int ans = 0;
        while(low<=high){

            int mid = (low+high)/2;
            int numdays = caldays(weights,mid);
            if(numdays>days){
                low = mid+1;
            }
            else{
                ans = mid;
                high = mid-1;
            }
        }
        return ans;
    }
}
