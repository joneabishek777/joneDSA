https://leetcode.com/problems/split-array-largest-sum/
class Solution {
    public int calsplit(int []nums,int cap){
        int sum =0,split=1,n=nums.length;
        for(int i=0;i<n;i++){
            if(sum+nums[i]<=cap){
                sum=sum+nums[i];
            }
            else{
                sum = nums[i];
                split++;
            }
        }
        return split;
    }
    public int splitArray(int[] nums, int k) {
        int low=0;
        int high=0;
        for(int i=0;i<nums.length;i++){
            high = high+nums[i];
            low = Math.max(low,nums[i]);
        }
        int ans =0;
        while(low<=high){
        int mid = (low+high)/2;
        int numsplit = calsplit(nums,mid);
        if(numsplit>k){
            low = mid+1;
        }
        else{
            ans = mid;
            high = mid-1;
        }

        }
        return ans;

        
    }
}
