class Solution {
    int single(int[] arr) {
        // code here
     int i=0,j=arr.length-2;
     while(i<=j){
         int mid = (i+j)/2;
         if(mid%2==0){
             if(arr[mid]==arr[mid+1]){
                 i = mid+1;
             }
             else{
                 j=mid-1;
             }
         }
         else{
             if(arr[mid]==arr[mid-1]){
                 i=mid+1;
             }
             else{
                 j=mid-1;
             }
         }
     }
     return arr[i];
    }
}
