class Solution {
    public int findKRotation(int arr[]) {
        // Code here
        int n=arr.length;
        int l=0;
        int h=n-1;
        while(l<=h){
            int mid = (l+h)/2;
            int i = (mid-1+n)%n;
            int j = (mid+1)%n;
            if(arr[mid]<arr[i] && arr[mid]<arr[j]){
                return mid;
            }
            if(arr[h]>arr[mid]){
                h = mid-1;
            }
            else{
                l = mid+1;
            }
        }
        return 0;
    }
}
