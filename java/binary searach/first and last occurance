class Solution {
    ArrayList<Integer> find(int arr[], int x) {
    ArrayList<Integer> ans = new ArrayList<Integer>();
     int first = -1,last = -1;
     int i=0,j=arr.length-1;
     while(i<=j){
         int mid=(i+j)/2;
         if(arr[mid]==x){
             first = mid;
             j=mid-1;
         }
         else if(arr[mid]>x){
             j=mid-1;
         }
         else{
             i = mid+1;         
       }
     }
      i=0;
      j=arr.length-1;
       while(i<=j){
         int mid=(i+j)/2;
         if(arr[mid]==x){
             last = mid;
             i=mid+1;
         }
         else if(arr[mid]>x){
             j=mid-1;
         }
         else{
             i = mid+1;         
       }
       }
       
       ans.add(first);
       ans.add(last);
       
       return ans;
       
}
}

