class Solution {
    public int[] getFloorAndCeil(int x, int[] arr) {
        Arrays.sort(arr);
        int floor = findfloor(arr,x);
        int ceil = findceil(x,arr);
        
        return new int[]{floor,ceil};
    }

        
        private int findfloor (int [] arr,int x){
        int i=0,j=arr.length-1;
        if(arr[0]>x){
            return -1;
        }
        while(i<=j){
            int mid = (i+j)/2;
            if(arr[mid]==x){
                return x;
            }
            else if(arr[mid]>x){
                j=mid-1;
            }
            else{
                i=mid+1;
            }
        }
        return arr[j];
    }

        
       private int findceil (int x, int[] arr) {
        int i=0,j=arr.length-1;
        if(arr[arr.length - 1] < x){
            return -1;
        }
        while(i<=j){
            int mid = (i+j)/2;
            if(arr[mid]==x){
                return x;
            }
            else if(arr[mid]>x){
                j=mid-1;
            }
            else{
                i=mid+1;
            }
        }
        return arr[i];
        
        }
}
        
        
        
