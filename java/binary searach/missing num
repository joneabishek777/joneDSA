class Solution {
    int missingNum(int arr[]) {
        // code here
      Arrays.sort(arr);
      int i=0,j=arr.length-1;
      while(i<=j){
          int mid = (i+j)/2;
          if(arr[mid]==mid+1){
              i = mid+1;
          } 
          else{
              j = mid -1;
          }
      }
      return i+1;
    }
}
